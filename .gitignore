# Visual Studio user specific files
.vs/
.vsconfig
.vscode

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.code-workspace

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Game/
# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Platform specific
Platforms/**/Build/FileOpenOrder/

# Configuration files generated by the Editor
Saved/*
Config/Generated*.ini
Config/GameGenerated.ini

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Misc
Content/Engine/Transient.csv
Plugins/GameVersion/Source/Private/GameVersionDefine.h
Config/UserGame.ini

# Sentry
.sentry-native
Config/DefaultEditorPerProjectUserSettings.ini
Plugins/DLSS/Intermediate
Plugins/StreamlineReflex/Intermediate
Plugins/StreamlineReflex/Binaries/Win64
Plugins/StreamlineNGXCommon/Intermediate
Plugins/StreamlineDLSSG/Intermediate
Plugins/StreamlineDeepDVC/Intermediate
Plugins/StreamlineDeepDVC/Binaries/Win64
Plugins/StreamlineDLSSG/Binaries/Win64
Plugins/StreamlineNGXCommon/Binaries/Win64
Plugins/StreamlineCore/Intermediate
Plugins/StreamlineCore/Binaries/Win64
